# reason: build-time configuration only - lets DISTANCE_SQ_THRESHOLD, NEARBY_SCAN, both Huber loss scales (laserOdometry.cpp, laserMapping.cpp) and the scan period (scanRegistration.cpp + laserOdometry.cpp) be overridden per image via -DSLAMBENCH_DEFS; defaults equal upstream values (no algorithm change).
diff --git a/CMakeLists.txt b/CMakeLists.txt
index a4eedd3..e1619e5 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -30,6 +30,23 @@ include_directories(
   ${CERES_INCLUDE_DIRS}
   ${OpenCV_INCLUDE_DIRS})
 
+# [slambench] Build-time constant overrides. CMAKE_CXX_FLAGS is overwritten above, so -DCMAKE_CXX_FLAGS=... would be
+# ignored; use this cache variable instead. Empty (the default) = upstream values.
+# Usage: catkin_make -DSLAMBENCH_DEFS="DISTANCE_SQ_THRESHOLD_OVERRIDE=25 NEARBY_SCAN_OVERRIDE=2.5"
+set(SLAMBENCH_DEFS "" CACHE STRING "Space-separated NAME=VALUE overrides for A-LOAM compile-time constants")
+set(SLAMBENCH_ALLOWED SCAN_PERIOD_OVERRIDE DISTANCE_SQ_THRESHOLD_OVERRIDE NEARBY_SCAN_OVERRIDE
+    ODOM_HUBER_DELTA_OVERRIDE MAPPING_HUBER_DELTA_OVERRIDE)
+separate_arguments(SLAMBENCH_DEFS_LIST UNIX_COMMAND "${SLAMBENCH_DEFS}")
+foreach(slambench_def ${SLAMBENCH_DEFS_LIST})
+  string(REGEX REPLACE "=.*$" "" slambench_name "${slambench_def}")
+  list(FIND SLAMBENCH_ALLOWED "${slambench_name}" slambench_idx)
+  if(slambench_idx EQUAL -1)
+    message(FATAL_ERROR "SLAMBENCH_DEFS: unknown override '${slambench_name}' (allowed: ${SLAMBENCH_ALLOWED})")
+  endif()
+  add_definitions(-D${slambench_def})
+  message(STATUS "slambench override: ${slambench_def}")
+endforeach()
+
 catkin_package(
   CATKIN_DEPENDS geometry_msgs nav_msgs roscpp rospy std_msgs
   DEPENDS EIGEN3 PCL 
