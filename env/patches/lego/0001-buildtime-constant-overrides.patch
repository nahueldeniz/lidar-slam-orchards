# reason: build-time configuration only - lets the utility.h constants of brief tables 5.3 and the scan period be overridden per image via -DSLAMBENCH_DEFS; upstream lines kept verbatim, so no override = upstream values (no algorithm change).
diff --git a/LeGO-LOAM/CMakeLists.txt b/LeGO-LOAM/CMakeLists.txt
index efebe5b..3f52667 100755
--- a/LeGO-LOAM/CMakeLists.txt
+++ b/LeGO-LOAM/CMakeLists.txt
@@ -24,6 +24,22 @@ find_package(GTSAM REQUIRED QUIET)
 find_package(PCL REQUIRED QUIET)
 find_package(OpenCV REQUIRED QUIET)
 
+# [slambench] Build-time constant overrides for include/utility.h. Empty (the default) = upstream values.
+# Usage: catkin_make -DSLAMBENCH_DEFS="SEGMENT_THETA_DEG_OVERRIDE=30 NEAREST_FEATURE_SEARCH_SQ_DIST_OVERRIDE=10"
+set(SLAMBENCH_DEFS "" CACHE STRING "Space-separated NAME=VALUE overrides for constants in include/utility.h")
+set(SLAMBENCH_ALLOWED MAPPING_PROCESS_INTERVAL_OVERRIDE SCAN_PERIOD_OVERRIDE SEGMENT_THETA_DEG_OVERRIDE
+    EDGE_THRESHOLD_OVERRIDE SURF_THRESHOLD_OVERRIDE NEAREST_FEATURE_SEARCH_SQ_DIST_OVERRIDE)
+separate_arguments(SLAMBENCH_DEFS_LIST UNIX_COMMAND "${SLAMBENCH_DEFS}")
+foreach(slambench_def ${SLAMBENCH_DEFS_LIST})
+  string(REGEX REPLACE "=.*$" "" slambench_name "${slambench_def}")
+  list(FIND SLAMBENCH_ALLOWED "${slambench_name}" slambench_idx)
+  if(slambench_idx EQUAL -1)
+    message(FATAL_ERROR "SLAMBENCH_DEFS: unknown override '${slambench_name}' (allowed: ${SLAMBENCH_ALLOWED})")
+  endif()
+  add_definitions(-D${slambench_def})
+  message(STATUS "slambench override: ${slambench_def}")
+endforeach()
+
 catkin_package(
   INCLUDE_DIRS include
   CATKIN_DEPENDS cloud_msgs
