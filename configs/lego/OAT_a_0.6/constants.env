# LeGO-LOAM configuration D: compile-time constants (include/utility.h at 896a7a95a8bc510b76819d4cc48707e344bad621).
#
# Part 1 - Docker build args for env/docker/lego/Dockerfile (pass each as --build-arg KEY=VALUE).
# Empty value = no override = the upstream line is compiled (token-identical to upstream; checked, see
# configs/lego/source_audit.md Section 4). D uses no overrides.
MAPPING_PROCESS_INTERVAL=0.6
SEGMENT_THETA_DEG=
EDGE_THRESHOLD=
SURF_THRESHOLD=
NEAREST_FEATURE_SEARCH_SQ_DIST=
# Scan period: left at the upstream 0.1 s for every dataset, including a 4 Hz one. In LiDAR-only mode its only
# active use is encoding the point's sweep fraction (featureAssociation.cpp:523), which is decoded with a
# hard-coded 10 (= 1/0.1) at featureAssociation.cpp:862 and :887. Setting 0.25 s would scale the de-skew
# interpolation by 2.5 (an error). This deviates from brief Section 5.0 ("LiDAR rate"): see open questions.
SCAN_PERIOD=

# Part 2 - effective values in D, as the '[slambench-constants]' start-up lines must report them (%.9g).
# Checked by compiling the patched logging function on the host (x86-64, IEEE float). Float constants show float rounding.
EXPECT_loopClosureEnableFlag=0
EXPECT_mappingProcessInterval=0.3
EXPECT_scanPeriod=0.100000001
EXPECT_segmentTheta=1.04719758
EXPECT_segmentTheta_deg=60.0000017
EXPECT_edgeFeatureNum=2
EXPECT_surfFeatureNum=4
EXPECT_edgeThreshold=0.100000001
EXPECT_surfThreshold=0.100000001
EXPECT_nearestFeatureSearchSqDist=25
EXPECT_pointCloudTopic=/velodyne_points
EXPECT_imuTopic=/imu/data
EXPECT_useCloudRing=1
EXPECT_N_SCAN=16
EXPECT_Horizon_SCAN=1800
EXPECT_ang_res_x=0.200000003
EXPECT_ang_res_y=2
EXPECT_ang_bottom=15.1000004
EXPECT_groundScanInd=7
EXPECT_sensorMinimumRange=1
EXPECT_surroundingKeyframeSearchRadius=50
EXPECT_surroundingKeyframeSearchNum=50

# Units and module (FE = featureAssociation odometry, BE = mapOptmization; imageProjection is the shared
# pre-processing stage that feeds both):
#   mappingProcessInterval      s     BE  (mapOptmization.cpp:1499)
#   segmentTheta                rad   pre-processing -> FE and BE (imageProjection.cpp:423); override given in degrees
#   edgeThreshold, surfThreshold  curvature as computed in featureAssociation.cpp:626-633, i.e. (sum of range
#                                 differences)^2 in m^2   FE (featureAssociation.cpp:705, :740)
#   nearestFeatureSearchSqDist  m^2   FE (featureAssociation.cpp:1057, 1061, 1168, 1172)
#   scanPeriod                  s     FE encoding only in LiDAR-only mode (see above)
#   edgeFeatureNum, surfFeatureNum: declared, never referenced (featureAssociation.cpp:709 and :747 hard-code 2 and 4)
