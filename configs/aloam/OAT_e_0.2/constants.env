# A-LOAM configuration D: compile-time constants (A-LOAM devel at e51f88c12b483ce42dfa219783712c7234dc8c08).
#
# Part 1 - Docker build args for env/docker/aloam/Dockerfile (pass each as --build-arg KEY=VALUE).
# Empty value = no override = upstream value (for the two Huber scales the upstream literal 0.1 becomes a named
# constant with the same value; all other lines are compiled verbatim; see configs/aloam/source_audit.md Section 4).
# D uses no overrides.
DISTANCE_SQ_THRESHOLD=
NEARBY_SCAN=
ODOM_HUBER_DELTA=0.2
MAPPING_HUBER_DELTA=
# Scan period: one value sets both scanPeriod (scanRegistration.cpp:60) and SCAN_PERIOD (laserOdometry.cpp:64).
# With DISTORTION 0 (laserOdometry.cpp:59, upstream) neither affects the output; with DISTORTION 1 only their
# ratio would matter, and they are always equal. Left at the upstream 0.1 s; see open questions.
SCAN_PERIOD=

# Part 2 - effective values in D, as the '[slambench-constants]' start-up lines must report them (%.9g).
# Checked by compiling and running the patched node main() functions on the host with stub ROS headers.
EXPECT_scanPeriod=0.1
EXPECT_SCAN_PERIOD=0.1
EXPECT_DISTANCE_SQ_THRESHOLD=25
EXPECT_NEARBY_SCAN=2.5
EXPECT_ODOM_HUBER_DELTA=0.1
EXPECT_MAPPING_HUBER_DELTA=0.1
EXPECT_DISTORTION=0
EXPECT_systemDelay=0
# ROS parameters of D (set in configs/aloam/D/aloam_velodyne_VLP_16.launch; printed by the same start-up lines):
EXPECT_scan_line=16
EXPECT_minimum_range=0.3
EXPECT_mapping_skip_frame=1
EXPECT_mapping_line_resolution=0.200000003
EXPECT_mapping_plane_resolution=0.400000006

# Units and module (FE = alaserOdometry, BE = alaserMapping; ascanRegistration is the shared pre-processing stage):
#   DISTANCE_SQ_THRESHOLD   m^2          FE  laserOdometry.cpp:305, 310, 393, 399 (squared nearest-neighbour gate)
#   NEARBY_SCAN             scan lines   FE  laserOdometry.cpp:319, 345, 405, 433 (compared with integer ring ids,
#                                            so 2.5 behaves as 2; any value in [2, 3) is equivalent)
#   ODOM_HUBER_DELTA        m            FE  laserOdometry.cpp:284 (Huber scale on point-to-line/plane distance)
#   MAPPING_HUBER_DELTA     m            BE  laserMapping.cpp:565
#   mapping_line_resolution, mapping_plane_resolution  m  BE  laserMapping.cpp:902-906 (voxel leaf sizes);
#                           code defaults 0.4 and 0.8 apply only if the launch file does not set them
#   scan_line, minimum_range  pre-processing (scanRegistration.cpp:466, 468; code defaults 16 and 0.1)
#   mapping_skip_frame      FE->BE hand-over (laserOdometry.cpp:191, 570; code default 2)
