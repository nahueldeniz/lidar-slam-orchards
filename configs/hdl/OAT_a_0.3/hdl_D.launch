<?xml version="1.0"?>
<!--
  hdl Graph SLAM - configuration D (default) for the orchard benchmark re-run.
  Derived from launch/hdl_graph_slam_400.launch (the README's outdoor example) at
  koide3/hdl_graph_slam@95b8dce41c10667dcf0e3e9801dc22754b3bd525.

  Rules followed:
    * Every line that differs from upstream carries a CHANGED / ADDED / REMOVED comment; all other lines are verbatim.
    * LiDAR only: GPS, IMU (graph, front-end and deskewing) and wheel-odometry inputs are hard-wired to false.
    * No RViz (upstream hdl_graph_slam_400.launch starts none either).
    * Per-dataset sensor settings have NO default, so roslaunch fails if one is forgotten:
        sensor_height (m), tilt_deg (deg).
    * The tuned parameters (configs/hdl/tuning_levels.yaml) are exposed as args whose defaults are the
      D (= upstream) values, so T and one-at-a-time runs only pass arguments and this file stays frozen.
  Example:
    roslaunch hdl_D.launch sensor_height:=0.5317 tilt_deg:=0.0
-->
<launch>
  <!-- arguments -->
  <arg name="nodelet_manager" default="velodyne_nodelet_manager" />
  <arg name="enable_floor_detection" default="true" />   <!-- kept as an arg: Section 5.2 ablation sets it to false -->
  <!-- REMOVED: args enable_gps, enable_imu_acc, enable_imu_ori (upstream defaults false); the params are hard-wired to false below so they cannot be switched on by an argument -->

  <arg name="points_topic" default="/velodyne_points" />
  <arg name="map_frame_id" default="map" />
  <arg name="lidar_odom_frame_id" default="odom" />

  <!-- optional arguments -->
  <!-- REMOVED: arg enable_robot_odometry_init_guess (upstream default false); hard-wired to false below (no wheel odometry) -->
  <arg name="robot_odom_frame_id" default="robot_odom" />

  <!-- ADDED: per-dataset sensor settings, no defaults (upstream literals: sensor_height 2.0, tilt_deg 0.0) -->
  <arg name="sensor_height" />   <!-- ADDED: m, height of base_link (= LiDAR frame) above the floor; 0.5317 for Pullally (C4) -->
  <arg name="tilt_deg" />   <!-- ADDED: deg, LiDAR pitch w.r.t. the floor (rotation about y) -->
  <!-- ADDED: frame_id of the LiDAR point clouds in the bag (upstream literal 'velodyne'); must match the inventory -->
  <arg name="lidar_frame_id" default="velodyne" />   <!-- ADDED -->

  <!-- ADDED: tuned parameters, defaults = upstream hdl_graph_slam_400.launch values (configuration D) -->
  <arg name="downsample_resolution" default="0.1" />              <!-- ADDED: prefiltering_nodelet, m -->
  <arg name="radius_radius" default="0.5" />                      <!-- ADDED: prefiltering_nodelet, m -->
  <arg name="fe_keyframe_delta_trans" default="1.0" />            <!-- ADDED: scan_matching_odometry_nodelet, m -->
  <arg name="fe_keyframe_delta_angle" default="1.0" />            <!-- ADDED: scan_matching_odometry_nodelet, compared with acos(q.w) = half the rotation angle, rad -->
  <arg name="be_keyframe_delta_trans" default="2.0" />            <!-- ADDED: hdl_graph_slam_nodelet, m -->
  <arg name="be_keyframe_delta_angle" default="2.0" />            <!-- ADDED: hdl_graph_slam_nodelet, full rotation angle, rad -->
  <arg name="reg_max_correspondence_distance" default="2.0" />    <!-- ADDED: both nodelets (equal upstream), m -->

  <!-- transformation between lidar and base_link -->
  <node pkg="tf" type="static_transform_publisher" name="lidar2base_publisher" args="0 0 0 0 0 0 base_link $(arg lidar_frame_id) 10" />   <!-- CHANGED: child frame from arg (upstream 'velodyne'); identity kept, so base_link == LiDAR frame -->

  <!-- in case you use velodyne_driver, comment out the following line -->
  <node pkg="nodelet" type="nodelet" name="$(arg nodelet_manager)" args="manager" output="screen"/>

  <!-- prefiltering_nodelet -->
  <node pkg="nodelet" type="nodelet" name="prefiltering_nodelet" args="load hdl_graph_slam/PrefilteringNodelet $(arg nodelet_manager)">
    <remap from="/velodyne_points" to="$(arg points_topic)" />
    <!-- in case base_link_frame is blank, mapping will be performed in the lidar frame -->
    <param name="base_link_frame" value="base_link" />
    <param name="deskewing" value="false" />   <!-- ADDED: code default false (prefiltering_nodelet.cpp:40); true would subscribe /imu/data -->
    <!-- distance filter -->
    <param name="use_distance_filter" value="true" />
    <param name="distance_near_thresh" value="0.1" />
    <param name="distance_far_thresh" value="100.0" />
    <!-- NONE, VOXELGRID, or APPROX_VOXELGRID -->
    <param name="downsample_method" value="VOXELGRID" />
    <param name="downsample_resolution" value="$(arg downsample_resolution)" />   <!-- CHANGED: value from arg (D = 0.1, upstream literal) -->
    <!-- NONE, RADIUS, or STATISTICAL -->
    <param name="outlier_removal_method" value="RADIUS" />
    <param name="statistical_mean_k" value="30" />
    <param name="statistical_stddev" value="1.2" />
    <param name="radius_radius" value="$(arg radius_radius)" />   <!-- CHANGED: value from arg (D = 0.5, upstream literal) -->
    <param name="radius_min_neighbors" value="2" />
  </node>

  <!-- scan_matching_odometry_nodelet -->
  <node pkg="nodelet" type="nodelet" name="scan_matching_odometry_nodelet" args="load hdl_graph_slam/ScanMatchingOdometryNodelet $(arg nodelet_manager)">
    <param name="points_topic" value="$(arg points_topic)" />
    <param name="odom_frame_id" value="$(arg lidar_odom_frame_id)" />
    <param name="robot_odom_frame_id" value="$(arg robot_odom_frame_id)" />
    <param name="keyframe_delta_trans" value="$(arg fe_keyframe_delta_trans)" />   <!-- CHANGED: value from arg (D = 1.0, upstream literal) -->
    <param name="keyframe_delta_angle" value="$(arg fe_keyframe_delta_angle)" />   <!-- CHANGED: value from arg (D = 1.0, upstream literal) -->
    <param name="keyframe_delta_time" value="10000.0" />
    <param name="transform_thresholding" value="false" />
    <param name="enable_robot_odometry_init_guess" value="false" />   <!-- CHANGED: literal false (upstream: arg, default false); no wheel odometry -->
    <param name="enable_imu_frontend" value="false" />   <!-- ADDED: code default false (scan_matching_odometry_nodelet.cpp:48); true would subscribe /msf_core/pose* -->
    <param name="max_acceptable_trans" value="1.0" />
    <param name="max_acceptable_angle" value="1.0" />
    <param name="downsample_method" value="NONE" />
    <param name="downsample_resolution" value="0.1" />
    <!-- ICP, GICP, NDT, GICP_OMP, NDT_OMP, FAST_GICP(recommended), or FAST_VGICP -->
    <param name="registration_method" value="FAST_GICP" />
    <param name="reg_num_threads" value="0" />
    <param name="reg_transformation_epsilon" value="0.1"/>
    <param name="reg_maximum_iterations" value="64"/>
    <param name="reg_max_correspondence_distance" value="$(arg reg_max_correspondence_distance)"/>   <!-- CHANGED: value from arg (D = 2.0, upstream literal) -->
    <param name="reg_max_optimizer_iterations" value="20"/>
    <param name="reg_use_reciprocal_correspondences" value="false"/>
    <param name="reg_correspondence_randomness" value="20"/>
    <param name="reg_resolution" value="1.0" />
    <param name="reg_nn_search_method" value="DIRECT7" />
  </node>

  <!-- floor_detection_nodelet -->
  <node pkg="nodelet" type="nodelet" name="floor_detection_nodelet" args="load hdl_graph_slam/FloorDetectionNodelet $(arg nodelet_manager)" if="$(arg enable_floor_detection)">
    <param name="points_topic" value="$(arg points_topic)" />
    <param name="tilt_deg" value="$(arg tilt_deg)" />   <!-- CHANGED: per-dataset arg (upstream literal 0.0) -->
    <param name="sensor_height" value="$(arg sensor_height)" />   <!-- CHANGED: per-dataset arg (upstream literal 2.0) -->
    <param name="height_clip_range" value="1.0" />
    <param name="floor_pts_thresh" value="512" />
    <param name="use_normal_filtering" value="true" />
    <param name="normal_filter_thresh" value="20.0" />
  </node>

  <!-- hdl_graph_slam_nodelet -->
  <node pkg="nodelet" type="nodelet" name="hdl_graph_slam_nodelet" args="load hdl_graph_slam/HdlGraphSlamNodelet $(arg nodelet_manager)">
    <param name="points_topic" value="$(arg points_topic)" />
    <!-- frame settings -->
    <param name="map_frame_id" value="$(arg map_frame_id)" />
    <param name="odom_frame_id" value="$(arg lidar_odom_frame_id)" />
    <!-- optimization params -->
    <!-- typical solvers: gn_var, gn_fix6_3, gn_var_cholmod, lm_var, lm_fix6_3, lm_var_cholmod, ... -->
    <param name="g2o_solver_type" value="lm_var_cholmod" />
    <param name="g2o_solver_num_iterations" value="512" />
    <!-- constraint switches -->
    <param name="enable_gps" value="false" />   <!-- CHANGED: literal false (upstream: arg, default false); note the C++ default is TRUE (hdl_graph_slam_nodelet.cpp:119) -->
    <param name="enable_imu_acceleration" value="false" />   <!-- CHANGED: literal false (upstream: arg enable_imu_acc, default false) -->
    <param name="enable_imu_orientation" value="false" />   <!-- CHANGED: literal false (upstream: arg enable_imu_ori, default false) -->
    <!-- keyframe registration params -->
    <param name="max_keyframes_per_update" value="10" />
    <param name="keyframe_delta_trans" value="$(arg be_keyframe_delta_trans)" />   <!-- CHANGED: value from arg (D = 2.0, upstream literal) -->
    <param name="keyframe_delta_angle" value="$(arg be_keyframe_delta_angle)" />   <!-- CHANGED: value from arg (D = 2.0, upstream literal) -->
    <!-- fix first node for optimization stability -->
    <param name="fix_first_node" value="true"/>
    <param name="fix_first_node_stddev" value="10 10 10 1 1 1"/>
    <param name="fix_first_node_adaptive" value="true"/>
    <!-- loop closure params -->
    <param name="distance_thresh" value="15.0" />
    <param name="accum_distance_thresh" value="25.0" />
    <param name="min_edge_interval" value="15.0" />
    <param name="fitness_score_thresh" value="2.5" />
    <!-- scan matching params -->
    <param name="registration_method" value="FAST_GICP" />
    <param name="reg_num_threads" value="0" />
    <param name="reg_transformation_epsilon" value="0.1"/>
    <param name="reg_maximum_iterations" value="64"/>
    <param name="reg_max_correspondence_distance" value="$(arg reg_max_correspondence_distance)"/>   <!-- CHANGED: value from arg (D = 2.0, upstream literal) -->
    <param name="reg_max_optimizer_iterations" value="20"/>
    <param name="reg_use_reciprocal_correspondences" value="false"/>
    <param name="reg_correspondence_randomness" value="20"/>
    <param name="reg_resolution" value="1.0" />
    <param name="reg_nn_search_method" value="DIRECT7" />
    <!-- edge params -->
    <!-- GPS -->
    <param name="gps_edge_robust_kernel" value="NONE" />
    <param name="gps_edge_robust_kernel_size" value="1.0" />
    <param name="gps_edge_stddev_xy" value="20.0" />
    <param name="gps_edge_stddev_z" value="5.0" />
    <!-- IMU orientation -->
    <param name="imu_orientation_edge_robust_kernel" value="NONE" />
    <param name="imu_orientation_edge_stddev" value="1.0" />
    <!-- IMU acceleration (gravity vector) -->
    <param name="imu_acceleration_edge_robust_kernel" value="NONE" />
    <param name="imu_acceleration_edge_stddev" value="1.0" />
    <!-- ground plane -->
    <param name="floor_edge_robust_kernel" value="NONE" />
    <param name="floor_edge_stddev" value="10.0" />
    <!-- scan matching -->
    <!-- robust kernels: NONE, Cauchy, DCS, Fair, GemanMcClure, Huber, PseudoHuber, Saturated, Tukey, Welsch -->
    <param name="odometry_edge_robust_kernel" value="NONE" />
    <param name="odometry_edge_robust_kernel_size" value="1.0" />
    <param name="loop_closure_edge_robust_kernel" value="Huber" />
    <param name="loop_closure_edge_robust_kernel_size" value="1.0" />
    <param name="use_const_inf_matrix" value="false" />
    <param name="const_stddev_x" value="0.5" />
    <param name="const_stddev_q" value="0.1" />
    <param name="var_gain_a" value="20.0" />
    <param name="min_stddev_x" value="0.1" />
    <param name="max_stddev_x" value="5.0" />
    <param name="min_stddev_q" value="0.05" />
    <param name="max_stddev_q" value="0.2" />
    <!-- update params -->
    <param name="graph_update_interval" value="3.0" />
    <param name="map_cloud_update_interval" value="10.0" />
    <param name="map_cloud_resolution" value="0.05" />
  </node>

  <node pkg="hdl_graph_slam" type="map2odom_publisher.py" name="map2odom_publisher" />
</launch>
